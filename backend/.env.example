# LLM Configuration (OpenAI Compatible)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.groq.com/openai/v1 # Change this if using a compatible service like Together, Groq, or OpenRouter
LLM_MODEL_NAME=qwen/qwen3.8-27b # Primary model (tested live on Groq)
# Fallback when primary fails; reuses OPENAI_API_KEY if GROQ_API_KEY empty
GROQ_API_KEY=your_groq_api_key_here
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
# Vision (portfolio photos). Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Auth
JWT_SECRET_KEY=change_me_to_at_least_32_characters_long

# Infra
USE_CELERY=False
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://jhic_user:jhic_password@localhost:5432/jhic_db

# Redis
REDIS_URL=redis://localhost:6379/0
